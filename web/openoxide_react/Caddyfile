# OpenOxide web dashboard — static SPA + panel API proxy.
#
# TLS terminates at Traefik (edge), so Caddy serves plain HTTP on :80
# inside the docker network. Traefik's h2/h3 to the browser is unaffected.
# Caddy speaks HTTP/1.1 + h2c to the panel upstream automatically.

:80 {
	# SPA static files with history-mode routing fallback.
	root * /srv
	encode gzip zstd

	# Static assets are content-hashed; cache hard.
	@static {
		path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
	}
	header @static Cache-Control "public, no-transform, max-age=31536000"

	# ConnectRPC panel API. Every RPC lives under /openoxide.api.v1.*;
	# streaming RPCs (WatchTables, OpenTerminal, ExecTask) hold the response
	# open indefinitely, so flushing must be immediate. The panel's hyper
	# server speaks h2c (prior knowledge), verified live — the upstream
	# connection runs HTTP/2 over cleartext.
	@connectrpc path /openoxide.api.*
	reverse_proxy @connectrpc openoxide:4000 {
		flush_interval -1
		transport http {
			versions h2c
		}
	}

	# Legacy REST proxy (vite dev parity: /api/* → panel with prefix stripped).
	# Kept for builds that pin VITE_API_URL=/api.
	handle_path /api/* {
		reverse_proxy openoxide:4000 {
			flush_interval -1
			transport http {
				versions h2c
			}
		}
	}

	# SPA fallback for everything else.
	try_files {path} /index.html
	file_server
}

DATABASE_URL=sqlite:///run/media/das/SSD/Devloper/rustploy/data/db.sqlite3
JWT_DEBUG_SKIP_TIME_CHECK=true
RUSTPLOY_BASE_PATH=/run/media/das/SSD/Devloper/rustploy/.runtime/rustploy
METRICS_TOKEN=change_me_metrics_token
# Docker Desktop only shares /home, /etc, /usr, /var, /run — not /mnt, so the
# in-repo ./certs bind is rejected. Stage the mkcert pair (certs/) under a
# shared root and point the panel at it.
TLS_CERT_PATH=/home/das/.openoxide/certs/cert.pem
TLS_KEY_PATH=/home/das/.openoxide/certs/key.pem

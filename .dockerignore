# web/openoxide_react/dist/

# Local scratch and host build artifacts — never image inputs. Excluding
# these keeps the build context small (the agent-cpp build/ dir also used to
# bust its own COPY layer after every host `make compile`).
.runtime/
.scratch/
tmp/
experiments/agent-cpp/build/
lego-master/

# Never bake runtime state or secrets into an image
*.log
*.db
*.db-shm
*.db-wal
data/*
!data/db.sqlite3
.env
.envrc

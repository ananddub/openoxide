# =============================================================================
# Production Nginx Container for OpenOxide Web Dashboard
# =============================================================================
FROM nginx:alpine

# Remove default nginx configs & placeholders
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*

# Copy pre-built React SPA assets
COPY web/openoxide_react/dist /usr/share/nginx/html

# Copy custom nginx configuration with SPA routing and WebSocket/API reverse proxy
COPY web/openoxide_react/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

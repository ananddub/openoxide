# =============================================================================
# Production Caddy Container for OpenOxide Web Dashboard
# =============================================================================
# Serves the built React SPA and reverse-proxies the panel's ConnectRPC API
# (with streaming support). TLS terminates at Traefik on the host; Caddy
# only speaks plain HTTP inside the docker network.
FROM caddy:2-alpine

# Copy pre-built React SPA assets
COPY web/openoxide_react/dist /srv

# Copy Caddy configuration
COPY web/openoxide_react/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

# Build the agent as a static binary. The runtime intentionally includes the
# operational tools used by ExecTask: Docker/Compose, backups, source checkout
# and common deployment scripts.
FROM rust:alpine AS builder

RUN apk add --no-cache musl-dev gcc build-base ca-certificates

# Pinned nightly (1.100.0-nightly) matching rust-toolchain.toml
RUN rustup toolchain install nightly-2026-08-30 --profile minimal && \
    rustup default nightly-2026-08-30

WORKDIR /usr/src/openoxide

COPY Cargo.toml Cargo.lock ./
COPY agent ./agent
COPY crates ./crates
COPY proto ./proto

# The workspace root is a package, so cargo needs its targets to exist to load
# the manifest — but the agent never compiles them. A stub keeps this layer
# (and the dependency cache below) alive when panel sources change; copying
# real src/ re-linked the whole agent binary on every backend edit.
RUN mkdir -p src && echo "fn main() {}" > src/main.rs

# Static musl build. The flag is scoped to the target triple rather than set via
# RUSTFLAGS, which would also apply to proc-macro crates — those are host
# dynamic libraries and cannot be built static.
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C target-feature=+crt-static" \
    CARGO_BUILD_JOBS=8 \
    CARGO_TARGET_DIR=/usr/src/openoxide/target
# The target dir is a cache mount, so its contents never land in this layer —
# the binary is copied out to a plain path for stage 2 to pick up.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/usr/src/openoxide/target \
    cargo build --release --target x86_64-unknown-linux-musl -p agent && \
    cp target/x86_64-unknown-linux-musl/release/agent /usr/src/openoxide/agent-binary && \
    strip /usr/src/openoxide/agent-binary

# The agent is the host-operation boundary, so tools live here instead of in
# the Openoxide panel image.
FROM alpine:3.21

RUN apk add --no-cache \
    bash \
    ca-certificates \
    coreutils \
    curl \
    docker-cli \
    docker-cli-compose \
    findutils \
    git \
    git-lfs \
    gzip \
    iproute2 \
    iptables \
    jq \
    openresolv \
    openssh-client \
    openssl \
    rclone \
    tar \
    unzip \
    wireguard-tools \
    zip \
    && git lfs install --system

# Keep build execution on the Agent. Nixpacks and Railpack are installed with
# the same pinned versions used by the server setup flow; Pack pulls the
# selected Heroku/Paketo builder image through the mounted Docker daemon.
ARG NIXPACKS_VERSION=1.41.0
ARG RAILPACK_VERSION=0.15.4
ARG PACK_VERSION=0.39.1
RUN curl -fsSL https://nixpacks.com/install.sh | NIXPACKS_VERSION=${NIXPACKS_VERSION} bash \
    && curl -fsSL https://railpack.com/install.sh | RAILPACK_VERSION=${RAILPACK_VERSION} bash \
    && curl -fsSL "https://github.com/buildpacks/pack/releases/download/v${PACK_VERSION}/pack-v${PACK_VERSION}-linux.tgz" \
       | tar -xzf - -C /usr/local/bin --no-same-owner pack \
    && nixpacks --version \
    && railpack --version \
    && pack --version

COPY --from=builder /usr/src/openoxide/agent-binary /agent

WORKDIR /app
RUN mkdir -p /app/data /app/workspace
ENV GRPC_PORT=50051 \
    RUST_LOG=agent=info

EXPOSE 50051

ENTRYPOINT ["/agent"]
